# /opt/ongil/ongil.env — systemd EnvironmentFile. 600 권한으로 저장하고 git에는 올리지 마세요.
PORT=8765
ONGIL_DB=/opt/ongil/ongil.sqlite3

# 데모 비밀번호 그대로 두지 말고 교체하세요. (openssl rand -base64 24 등으로 생성)
ONGIL_ADMIN_PASSWORD=
ONGIL_OPERATOR_PASSWORD=

# Caddy가 HTTPS를 맡아줄 때만 1로 설정합니다. (아래 Caddyfile을 쓰는 구성이면 1)
ONGIL_COOKIE_SECURE=1

# 결제 모듈 — 아직 verify_event 연동 전이라면 linkpayment-test로 테스트만 공개 배포하거나,
# PG 승인 확정 연동을 마친 뒤 실제 운영 키로 교체하세요.
PAYMENT_MODE=linkpayment-test
LINKPAYMENT_TEST_PUBLIC_KEY=
LINKPAYMENT_TEST_TERMINAL_CONFIRMED=yes
